{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-richie:incidents:event:v1:receipt",
  "title": "Atlas Richie Incident Event V1 Durable Receipt",
  "description": "Collector acknowledgement returned only after durable commit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "event_id", "body_sha256", "received_at"],
  "properties": {
    "protocol_version": { "const": "atlas-richie.incident-events/v1" },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
