{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-richie:reporting:metrics-v2-receipt",
  "title": "Atlas Richie Metrics Reporting V2 Durable Receipt",
  "description": "Collector acknowledgement emitted only after the accepted snapshot and receipt are committed atomically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "reporter_id",
    "startup_epoch",
    "sequence",
    "body_sha256",
    "received_at"
  ],
  "properties": {
    "protocol_version": { "const": "atlas-richie.metrics/v2" },
    "reporter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "startup_epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
