{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-richie:reporting:metrics-v2",
  "title": "Atlas Richie Metrics Reporting V2 Snapshot",
  "description": "Frozen snapshot wire shape. Authentication, enrollment, acknowledgement, and storage semantics are defined by ADR-SEN-020.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "reporter_id",
    "startup_epoch",
    "sequence",
    "captured_at",
    "capture_elapsed_ns",
    "counters",
    "histograms",
    "gauges"
  ],
  "properties": {
    "protocol_version": { "const": "atlas-richie.metrics/v2" },
    "reporter_id": { "$ref": "#/$defs/identifier" },
    "startup_epoch": { "$ref": "#/$defs/uuid" },
    "sequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "UTC diagnostic capture time, fixed to six fractional digits."
    },
    "capture_elapsed_ns": {
      "$ref": "#/$defs/decimalCount",
      "description": "Canonical decimal monotonic elapsed nanoseconds since this process epoch origin; compare only within the same authenticated reporter and epoch."
    },
    "counters": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/counter" }
    },
    "histograms": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/histogram" }
    },
    "gauges": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/gauge" }
    }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimalCount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "description": "Canonical non-negative decimal integer, limited to 38 digits for exact cross-language cumulative values and elapsed time."
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Canonical lowercase opaque UUID generated anew for each process start."
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
      "description": "Trimmed non-blank Unicode scalar string."
    },
    "resource": { "$ref": "#/$defs/identifier" },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "enum": [
            "http_requests_completed_total",
            "sentinel_entries_admitted_total",
            "sentinel_entries_blocked_total",
            "business_transactions_completed_total"
          ]
        },
        "value": { "$ref": "#/$defs/safeInteger" },
        "resource": { "$ref": "#/$defs/resource" }
      }
    },
    "histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "boundaries_ns",
        "bucket_counts",
        "sample_count",
        "total_ns",
        "min_ns",
        "max_ns"
      ],
      "properties": {
        "name": { "const": "http_request_duration" },
        "boundaries_ns": {
          "const": [1000000, 5000000, 10000000, 25000000, 50000000, 100000000, 250000000, 500000000, 1000000000, 2000000000, 5000000000, 10000000000],
          "description": "Frozen inclusive HTTP duration boundaries in nanoseconds."
        },
        "bucket_counts": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/safeInteger" },
          "description": "Disjoint buckets followed by one overflow bucket; length must equal boundaries_ns length plus one."
        },
        "sample_count": { "$ref": "#/$defs/safeInteger" },
        "total_ns": { "$ref": "#/$defs/decimalCount" },
        "min_ns": { "oneOf": [{ "$ref": "#/$defs/safeInteger" }, { "type": "null" }] },
        "max_ns": { "oneOf": [{ "$ref": "#/$defs/safeInteger" }, { "type": "null" }] },
        "resource": { "$ref": "#/$defs/resource" }
      }
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "quality"],
      "properties": {
        "name": {
          "enum": [
            "process_cpu_ratio",
            "process_rss_bytes",
            "process_memory_ratio",
            "event_loop_lag_ns"
          ]
        },
        "value": {
          "anyOf": [
            { "$ref": "#/$defs/safeInteger" },
            { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "quality": { "enum": ["available", "unavailable"] }
      }
    }
  }
}
