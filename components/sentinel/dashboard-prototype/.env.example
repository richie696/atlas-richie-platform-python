# Local development defaults to mock mode when VITE_CONSOLE_MODE is omitted.
VITE_CONSOLE_MODE=mock

# Start with an initialized demo account set (default), or exercise the first-run setup flow.
# The first-run profile is synthetic: bootstrap and connectivity checks never contact real services.
# VITE_CONSOLE_MOCK_BOOTSTRAP_PROFILE=first-run

# For local development against a controlled Console API, use:
# VITE_CONSOLE_MODE=live
# VITE_CONSOLE_API_BASE_URL=https://sentinel-console.example.com
# Production builds are live-only and default to same-origin when this is unset.
