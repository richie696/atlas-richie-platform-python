{
  "name": "dashboard-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/e2e/probes tests/performance --max-warnings=0",
    "format": "prettier --write src tests/e2e/probes tests/performance vite.config.mjs tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check src tests/e2e/probes tests/performance vite.config.mjs tsconfig.json eslint.config.mjs",
    "test:logic": "node --test tests/logic/run.mjs",
    "test:logic:focused": "node scripts/test/run-focused.mjs logic",
    "test:http": "node --test tests/http/run.mjs",
    "test:http:focused": "node scripts/test/run-focused.mjs http",
    "test:integration:rule-catalog": "node --test tests/integration/rule-catalog-python-http.test.mjs tests/verification/rule-catalog-python-mounted.test.mjs",
    "contract:generate": "node scripts/contracts/export-console.mjs",
    "contract:check": "node scripts/contracts/export-console.mjs --check",
    "test:lint": "node --test tests/lint/hooks.test.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:browser-tools": "node --test tests/e2e/cdp.test.mjs tests/e2e/artifacts.test.mjs tests/e2e/edge-lifecycle.test.mjs",
    "test:visual-tools": "node --test tests/visual/dom-normalization.test.mjs tests/visual/compare.test.mjs",
    "test:i18n-tools": "node --test tests/i18n/source-keys.test.mjs tests/i18n/catalog.test.mjs tests/i18n/audit.test.mjs tests/i18n/dynamic-callsite-coverage.test.mjs",
    "test:verification-tools": "node --test tests/verification/*.test.mjs",
    "verify": "node scripts/verify.mjs --static-only",
    "check:fast": "npm run typecheck && npm run format:check && npm run lint && npm run contract:check",
    "check:full": "npm run typecheck && npm run format:check && npm run lint && npm run test:lint && npm run test:architecture && npm run test:logic && npm run test:http && npm run contract:check && npm run test:browser-tools && npm run test:visual-tools && npm run test:i18n-tools && npm run test:verification-tools && npm run i18n:check && npm run build && npm run build:demo && npm run test:build-profiles && npm run test:sites",
    "check": "npm run check:fast",
    "check:milestone": "npm run check:full",
    "build": "vite build && node scripts/build/bundle-report.mjs dist/client && node scripts/prepare-sites-build.mjs",
    "build:console-assets": "npm run build && node scripts/package-console-assets.mjs",
    "build:demo": "vite build --mode demo && node scripts/build/bundle-report.mjs dist/demo/client",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:build-profiles": "node --test tests/build-profile.test.mjs tests/build-path.test.mjs tests/package-console-assets.test.mjs",
    "i18n:audit": "node tests/i18n/audit.mjs",
    "i18n:probe": "node tests/i18n/probe-cjk.mjs",
    "test:e2e": "node scripts/test/run-edge-e2e.mjs",
    "i18n:check": "node tests/i18n/keycheck.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.1",
    "@astryxdesign/theme-neutral": "0.6.1",
    "@nivo/line": "^0.99.0",
    "@phosphor-icons/react": "^2.1.10",
    "@richie696/react-framework": "^1.0.2",
    "@richie696/react-framework-react": "^1.0.2",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@stylexjs/stylex": "0.19.0",
    "@vitejs/plugin-react": "5.0.4",
    "github-slugger": "^2.0.0",
    "i18next": "^26.4.2",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "vfile": "^6.0.3",
    "vite": "6.4.2",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.1",
    "msw": "3.0.2",
    "prettier": "^3.9.6",
    "sass": "1.105.1",
    "typescript": "^7.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
